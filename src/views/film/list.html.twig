{% extends 'base.html.twig' %}

{% block title %}Liste des films{% endblock %}

{% block stylesheets %}
    <style>
        .film-table {
            margin-top: 20px;
        }
        .film-table th, .film-table td {
            text-align: center;
            vertical-align: middle;
        }
        .film-actions {
            display: flex;
            justify-content: center;
            gap: 10px;    
        }
        .film-actions form {
            display: inline;
        }
        .btn-custom-view {
            background-color: #17a2b8;
            color: white;
        }
        .btn-custom-update {
            background-color: #007bff;
            color: white;
        }
        .btn-custom-delete {
            background-color: #dc3545;
            color: white;
        }
    </style>
{% endblock %}

{% block content %}
    <h2 class="mb-4 text-center">
        <i class="fas fa-list" aria-hidden="true"></i> Liste des films
    </h2>

    {% if films is empty %}
        <p class="alert alert-warning text-center">Aucun film disponible pour le moment.</p>
    {% else %}
        <table class="table table-bordered table-hover table-striped film-table">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Titre</th>
                    <th>Année</th>
                    <th>Type</th>
                    <th>Réalisateur</th>
                    <th>Synopsis</th>
                    <th>Ajouté le</th>
                    <th>Modifié le</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                {% for film in films %}
                    <tr>
                        <td>{{ film.id }}</td>
                        <td>{{ film.title }}</td>
                        <td>{{ film.year }}</td>
                        <td>{{ film.type }}</td>
                        <td>{{ film.director }}</td>
                        <td>{{ film.synopsis }}</td>
                        <td>{{ film.createdAt.format('d/m/Y H:i') }}</td>
                        <td>{{ film.updatedAt.format('d/m/Y H:i') }}</td>
                        <td class="film-actions">
                            <a href="/film/read?id={{ film.id }}" class="btn btn-custom-view">Voir</a>
                            <a href="/film/update?id={{ film.id }}" class="btn btn-custom-update">Modifier</a>
                            <form action="/film/delete?id={{ film.id }}" method="post" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce film ?');">
                                <button type="submit" class="btn btn-custom-delete">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}